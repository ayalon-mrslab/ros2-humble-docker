# Copy to .env (or run ./docker_run.sh --ws <path>) and set your own path.
# Absolute path to your local ROS 2 workspace (the folder that contains src/) - mounted to
# /home/ros/ros2_ws
ROS_WS=/home/<user>/ros2_ws

# Optional: a project image built FROM the base image (set by ./docker_run.sh --image NAME)
# IMAGE=my-project-dev
# Optional: the container name, default ros2_humble (set by ./docker_run.sh --name NAME)
# CONTAINER_NAME=my_project
